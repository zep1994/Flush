<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Flush_Client.Pages.IngredientPage"
             Title="IngredientPage">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <StackLayout Margin="20">
            <Entry x:Name="IngredientEntry" Placeholder="Enter Ingredient" />
            <Button Text="Get Info" Clicked="LoadIngredients" />
            <Label Text="Ingredient Name:" FontSize="20" />
            <Label x:Name="NameLabel" FontSize="16" />


            <!-- Add a ScrollView to display JSON results -->
            <ScrollView>
                <StackLayout x:Name="JsonResultsLayout" Margin="0,20,0,0">
                    <!-- JSON results will be added here -->
                </StackLayout>
            </ScrollView>
        </StackLayout>


    </VerticalStackLayout>
</ContentPage>